{
  "name": "arcade",
  "version": "2.0.0",
  "description": "A 3D arcade for twelve browser games, drawn live in WebGL 2 with no 3D library. Day and Night, real gameplay on every screen.",
  "homepage": "https://arcade.ashwinsathian.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshwinSathian/arcade.git"
  },
  "bugs": "https://github.com/AshwinSathian/arcade/issues",
  "license": "MIT",
  "author": "Ashwin Sathian (https://ashwinsathian.com)",
  "keywords": [
    "arcade",
    "webgl2",
    "3d",
    "astro",
    "cloudflare-workers",
    "browser-games",
    "web-audio",
    "pbr",
    "hdr",
    "bloom"
  ],
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/pass.ts --watch & astro dev --port 4330",
    "build": "npm run pass && astro check && astro build",
    "preview": "wrangler dev --port 8799",
    "test": "npm run build && node --test tests/*.test.mjs tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:redirect": "wrangler deploy --config worker/redirect.jsonc",
    "capture": "node scripts/capture.ts",
    "hall": "node scripts/hall.ts",
    "og": "node scripts/og.ts",
    "shoot": "node scripts/shoot.ts",
    "pass": "node scripts/pass.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.165.0"
  }
}
