---
// The face has no arrows, so they are drawn. "out" points up-right (leaves the site), "right" points onward.
interface Props { dir?: "out" | "right" | "left" }
const { dir = "out" } = Astro.props;
const d = { out: "M4 12 12 4M5.5 4H12v6.5", right: "M2 8h12M9 3l5 5-5 5", left: "M14 8H2M7 3 2 8l5 5" }[dir];
---
<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
