---
// Pauses every clip on the page and the idle shimmer; remembered across pages. See src/scripts/site.ts.
---
<button class="still-toggle" type="button" aria-pressed="false" data-still-toggle>
  <svg viewBox="0 0 12 12" aria-hidden="true"><g class="off" fill="currentColor"><rect x="2" y="1" width="3" height="10" rx="1" /><rect x="7" y="1" width="3" height="10" rx="1" /></g><path class="on" d="M3 1.5v9l7.5-4.5z" fill="currentColor" /></svg>
  <span class="off">Pause clips</span><span class="on">Play clips</span>
</button>
