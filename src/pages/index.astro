---
import Base from "../layouts/Base.astro";
import GameTile from "../components/GameTile.astro";
import Arrow from "../components/Arrow.astro";
import StillToggle from "../components/StillToggle.astro";
import { games, site } from "../data/games";

const sized = games.filter((g) => g.kb !== null);
const maxKb = Math.max(...sized.map((g) => g.kb!));
const posts = games.filter((g) => g.post);

const title = "Seven free browser games: snake, pinball, sudoku and more";
const description = "Seven small games by Ashwin Sathian that open in a browser tab on phone, tablet or desktop. Free, with no install, no sign-up and no ads, and six of them are a single HTML file of 20 to 35 KB.";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site.url}/#site`,
    url: site.url,
    name: site.name,
    description,
    inLanguage: "en-GB",
    author: { "@type": "Person", "@id": `${site.authorUrl}/#person`, name: site.author, url: site.authorUrl, sameAs: [site.github] },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Games",
    numberOfItems: games.length,
    itemListElement: games.map((g, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${site.url}/${g.slug}`,
      name: g.name,
    })),
  },
];
---
<Base {title} {description} og="index" ogAlt="Seven tiles of real gameplay, one per game: Coil, Lightkeeper, Minefield, Nonet, Noughts, Rally and Typester, beside the words “Seven small games for your browser”." {jsonld}>
  <div class="board home">
    <section class="tile intro rise" aria-labelledby="title">
      <p class="intro__by"><a class="link" href={site.authorUrl}>Ashwin Sathian</a><StillToggle /></p>
      <h1 id="title">Seven small games for your browser</h1>
    </section>

    {games.map((g, i) => <GameTile game={g} i={i} eager={i < 2} class={`a-${g.slug}`} />)}

    <section class="tile say rise" style="--i:1" aria-label="What these are">
      <p>Snake, pinball, Minesweeper, sudoku, noughts and crosses, table tennis and a typing race. Each one opens in a tab on a phone or a laptop. Nothing to install, no account to make.</p>
    </section>

    <section class="tile weight rise" style="--i:2" aria-labelledby="weight-h">
      <h2 id="weight-h">How much each one weighs</h2>
      <ul class="bars">
        {sized.map((g) => (
          <li style={`--w:${((g.kb ?? 0) * 100) / maxKb}%;--c:${g.bright};--d:${g.ground}`}>
            <span class="bars__name">{g.name}</span><span class="bars__bar"></span><span class="bars__kb num">{g.kb} KB</span>
          </li>
        ))}
      </ul>
      <p class="weight__note">Each game’s HTML file, compressed. Coil, Nonet and Noughts also fetch a font (28 KB, 23 KB and 38 KB). Typester is an Angular app, so it isn’t on this list.</p>
      <p class="weight__live" data-weight aria-live="off"></p>
    </section>

    <section class="tile tile--accent pick rise" style="--i:3" aria-labelledby="pick-h">
      <h2 id="pick-h">Can’t choose?</h2>
      <p>Picked for you:</p>
      <p class="pick__name" data-pick-name>{games[2].name}</p>
      <p class="pick__acts">
        <a class="btn btn--light" href={games[2].url} data-pick data-play>Play <span data-pick-label>{games[2].name}</span> <Arrow /></a>
        <button class="btn pick__again" type="button" data-pick-again hidden>Pick again</button>
      </p>
    </section>
  </div>

  <section class="band" aria-labelledby="shelf-h">
    <h2 id="shelf-h" class="band__h">The seven side by side</h2>
    <div class="rows" data-ui>
      {games.map((g, i) => (
        <details name="shelf" open={i === 0} style={`--c:${g.bright};--d:${g.ground}`}>
          <summary>
            <span class="r__name">{g.name}</span>
            <span class="r__kind">{g.kind}</span>
            <span class="r__modes">{g.modes.length} modes</span>
            <span class="r__ctl">{g.controls}</span>
            <span class="r__kb num">{g.kb ? g.kb + " KB" : "App"}</span>
          </summary>
          <div class="r__open">
            <p>{g.line}</p>
            <p class="r__list">{g.modes.join(", ")}</p>
            <p class="r__acts">
              <a class="btn btn--light" href={g.url} data-play>Play {g.name} <Arrow /></a>
              <a class="link" href={`/${g.slug}`}>About {g.name}</a>
            </p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="made" aria-labelledby="made-h">
    <h2 id="made-h">The engineering underneath</h2>
    <p class="made__lede">Four of the games have a write-up on how they work.</p>
    <ul class="posts reveal">
      {posts.map((g) => (
        <li style={`--c:${g.bright};--d:${g.ground}`}>
          <a href={g.post!.url}>
            <span class="posts__game">{g.name}</span>
            <span class="posts__title">{g.post!.title}</span>
            <span class="posts__go">Read on ashwinsathian.com <Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* First screen: the name, seven clips, and the tiles that say what they are. */
  .home {
    grid-template-areas:
      "intro intro intro intro intro intro coil coil coil light light light"
      "say say say weight weight weight mine mine mine nonet nonet nonet"
      "nought nought nought rally rally rally type type type pick pick pick";
  }
  .intro { grid-area: intro; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; background: var(--ink); color: var(--bg); }
  .intro h1 { font-size: var(--t-display); font-weight: 750; max-width: 9ch; }
  .intro__by { font-size: var(--t-md); font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  :global(.a-coil) { grid-area: coil; }
  :global(.a-lightkeeper) { grid-area: light; }
  :global(.a-minefield) { grid-area: mine; }
  :global(.a-nonet) { grid-area: nonet; }
  :global(.a-noughts) { grid-area: nought; }
  :global(.a-rally) { grid-area: rally; }
  :global(.a-typester) { grid-area: type; }
  .say { grid-area: say; display: flex; align-items: flex-end; }
  .say p { font-size: clamp(1.375rem, 1.9vw, 1.75rem); line-height: 1.2; letter-spacing: -0.015em; font-weight: 500; }
  .weight { grid-area: weight; display: flex; flex-direction: column; gap: 18px; }
  .weight h2 { font-size: var(--t-md); letter-spacing: -0.01em; line-height: 1.2; }
  .bars { display: grid; gap: 8px; }
  .bars li { display: grid; grid-template-columns: 6.5em 1fr 3.4em; align-items: center; gap: 10px; font-size: var(--t-sm); }
  .bars__bar { height: 22px; border-radius: 4px; background: var(--surface-2); position: relative; overflow: hidden; }
  .bars__bar::after { content: ""; position: absolute; inset: 0; width: var(--w); background: var(--c); border-radius: 4px; transform-origin: left; animation: grow 900ms var(--ease) 300ms both; }
  @keyframes grow { from { transform: scaleX(0); } }
  .bars__kb { text-align: right; font-weight: 600; }
  .weight__note { font-size: var(--t-sm); }
  .weight__live { margin-top: auto; color: var(--muted); font-size: var(--t-sm); }
  .pick { grid-area: pick; container-type: inline-size; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  /* Sized to the tile, so the longest name (Lightkeeper) fits however narrow it is. */
  .pick h2 { font-size: min(var(--t-display), 15cqi); font-weight: 750; }
  .pick p { font-size: var(--t-lg); line-height: 1.15; }
  .pick__name { font-size: min(var(--t-display), 15cqi) !important; font-weight: 800; letter-spacing: -0.045em; line-height: 0.9 !important; margin: auto 0 12px; color: var(--accent-ink); }
  .pick__name.roll { animation: roll 420ms var(--spring); }
  @keyframes roll { from { opacity: 0; translate: 0 0.35em; } }
  .pick__acts { display: flex; flex-wrap: wrap; gap: 10px; }
  .pick__again { background: transparent; color: var(--accent-ink); box-shadow: inset 0 0 0 2px currentColor; }

  /* The board of rows: a departure board on a dark field. */
  .band { background: var(--band); color: var(--band-ink); margin-top: 120px; padding: 96px var(--edge); }
  .band__h { font-size: var(--t-display); margin-bottom: 40px; max-width: 14ch; }
  .rows { display: grid; gap: 4px; }
  .rows details { border-radius: var(--r); background: var(--band-row); overflow: hidden; transition: background-color 200ms; }
  .rows details[open] { background: var(--accent); color: var(--accent-ink); }
  @media (prefers-color-scheme: dark) { .rows details[open] { color: #0c0c0a; } }
  .rows summary {
    list-style: none; cursor: pointer; min-height: 76px;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); align-items: center;
    padding: 0 12px 0 20px; font-size: var(--t-md);
  }
  .rows summary::-webkit-details-marker { display: none; }
  .rows summary:hover .r__name { translate: 6px 0; }
  .r__name { grid-column: 1 / span 3; font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: 700; letter-spacing: -0.025em; transition: translate 240ms var(--spring); }
  .r__kind { grid-column: 4 / span 2; }
  .r__modes { grid-column: 6 / span 2; }
  .r__ctl { grid-column: 8 / span 4; color: var(--band-muted); font-size: var(--t-body); }
  details[open] .r__ctl { color: inherit; }
  .r__kb { grid-column: 12; justify-self: end; background: var(--c); color: var(--d); font-weight: 700; padding: 8px 12px; border-radius: 6px; min-width: 4.4em; text-align: center; }
  .r__open { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 12px var(--gap); padding: 4px 20px 28px; }
  .r__open > p:first-child { grid-column: 1 / span 7; font-size: var(--t-lg); line-height: 1.15; }
  .r__list { grid-column: 8 / span 5; }
  .r__acts { grid-column: 1 / -1; display: flex; align-items: center; gap: 24px; margin-top: 8px; }
  @media (prefers-reduced-motion: no-preference) {
    .rows details::details-content { block-size: 0; overflow: hidden; transition: block-size 380ms var(--ease), content-visibility 380ms allow-discrete; }
    .rows details[open]::details-content { block-size: auto; }
    :root { interpolate-size: allow-keywords; }
  }

  /* Write-ups: each in its game's colours. */
  .made { padding: 140px var(--edge) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); }
  .made h2 { grid-column: 1 / span 6; font-size: var(--t-display); }
  .made__lede { grid-column: 7 / span 5; align-self: end; font-size: var(--t-md); line-height: 1.4; }
  .posts { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: 40px; }
  .posts a {
    display: flex; flex-direction: column; gap: 16px; min-height: 340px; padding: 24px;
    border-radius: var(--r); background: var(--d); color: #f1efe8; text-decoration: none;
    transition: transform 260ms var(--spring);
  }
  .posts a:hover { transform: translateY(-6px); }
  .posts__game { color: var(--c); font-weight: 700; font-size: var(--t-md); }
  .posts__title { font-size: var(--t-lg); line-height: 1.08; letter-spacing: -0.02em; font-weight: 600; margin-bottom: auto; }
  .posts__go { display: flex; align-items: center; gap: 8px; font-size: var(--t-sm); }
  .posts__go :global(svg) { width: 12px; }

  @media (max-width: 1100px) {
    .home {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-areas:
        "intro intro intro intro intro intro"
        "coil coil coil light light light"
        "say say say weight weight weight"
        "mine mine mine nonet nonet nonet"
        "nought nought nought rally rally rally"
        "type type type pick pick pick";
    }
    .intro { min-height: 46svh; }
    .rows summary { grid-template-columns: 1fr auto; min-height: 68px; }
    .r__kind, .r__modes, .r__ctl { display: none; }
    .r__name { grid-column: 1; }
    .r__kb { grid-column: 2; }
    .r__open > p:first-child, .r__list { grid-column: 1 / -1; }
    .posts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .made h2, .made__lede { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .home {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: "intro intro" "say say" "coil light" "mine nonet" "nought rally" "type pick" "weight weight";
    }
    .intro { min-height: 38svh; }
    .home :global(.game) { --strip: 52px; }
    .home :global(.game__kind) { display: none; }
    .home :global(.game__strip) { padding-left: 12px; gap: 6px; }
    .home :global(.game__name) { font-size: 1.0625rem; }
    .home :global(.game__play) { padding: 0 14px; }
    .home :global(.game__play svg) { display: none; }
    .say p { font-size: 1.375rem; }
    .pick { min-height: 300px; }
    .band { margin-top: 80px; padding: 64px var(--edge); }
    .posts { grid-template-columns: 1fr; }
    .posts a { min-height: 220px; }
    .made { padding-top: 96px; }
  }
</style>
