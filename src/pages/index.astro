---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import StillToggle from "../components/StillToggle.astro";
import Lights from "../components/Lights.astro";
import { games, site } from "../data/games";

const posters = await Promise.all(games.map((g) => getImage({ src: g.poster, width: 480, format: "webp", quality: 72 })));
const hall = games.map((g, i) => ({ slug: g.slug, name: g.name, kind: g.kind, ground: g.ground, bright: g.bright, poster: posters[i].src, clip: `/media/${g.slug}.mp4` }));
const pad = (n: number) => String(n).padStart(2, "0");

const title = "The Arcade: twelve free browser games by Ashwin Sathian";
const description = "Twelve small games in a 3D arcade that opens in a browser tab on phone, tablet or desktop. Free, with no install, no sign-up and no ads, and eleven are one HTML file under 60 KB.";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site.url}/#site`,
    url: site.url,
    name: site.name,
    description,
    inLanguage: "en-GB",
    author: { "@type": "Person", "@id": `${site.authorUrl}/#person`, name: site.author, url: site.authorUrl, sameAs: [site.github] },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Games",
    numberOfItems: games.length,
    itemListElement: games.map((g, i) => ({ "@type": "ListItem", position: i + 1, url: `${site.url}/${g.slug}`, name: g.name })),
  },
];
---
<Base {title} {description} og="index" ogAlt="The Arcade at night: a row of twelve game cabinets under downlights, each screen playing its game, with a pink ARCADE neon on the wall." {jsonld}>
  <section class="hall" data-hall aria-labelledby="title">
    <canvas class="hall__gl" data-games={JSON.stringify(hall)} aria-hidden="true"></canvas>
    <header class="hall__top">
      <h1 id="title" class="hall__mark"><span>The Arcade</span> <a class="link" href={site.authorUrl}>by {site.author}</a></h1>
      <div class="hall__tools">
        <span class="hall__card" data-arcade-chip></span>
        <Lights />
        <button class="still-toggle hall__sound" type="button" aria-pressed="true" aria-label="Sound" data-sound hidden><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6h2.5L8 3v10L4.5 10H2z" fill="currentColor" /><path class="on" d="M10.5 5.5a3.5 3.5 0 0 1 0 5M12.5 3.5a6.3 6.3 0 0 1 0 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path class="off" d="m10.5 6 4 4m0-4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg><span class="hall__label">Sound</span></button>
        <StillToggle />
      </div>
    </header>

    <div class="hall__cards" aria-live="polite">
      {games.map((g, i) => (
        <article class="card" id={`m-${g.slug}`} data-card hidden={i !== 0} style={`--g-ground:${g.ground};--g-bright:${g.bright}`} aria-labelledby={`n-${g.slug}`}>
          <p class="card__kind"><span class="num">{pad(i + 1)} / {pad(games.length)}</span> {g.kind} <span class="card__last" data-last hidden>Played last</span></p>
          <h2 id={`n-${g.slug}`} class="card__name">{g.name}</h2>
          <p class="card__line">{g.line}</p>
          <p class="card__best" data-best hidden></p>
          <p class="card__price" data-price hidden></p>
          <p class="card__acts">
            <a class="card__play" href={g.url} data-play>Play {g.name} <Arrow /></a>
            <a class="card__about link" href={`/${g.slug}`}>About<span class="card__about-name">{` ${g.name}`}</span></a>
          </p>
        </article>
      ))}
    </div>

    <nav class="hall__row" aria-label="Machines">
      <button class="row__step" type="button" data-step="-1" aria-label="Previous machine"><Arrow dir="left" /></button>
      <ol>
        {games.map((g, i) => (
          <li><button type="button" data-go={i} aria-current={i === 0 ? "true" : undefined} aria-controls={`m-${g.slug}`} style={`--g-bright:${g.bright}`}><span class="num">{pad(i + 1)}</span> {g.name}</button></li>
        ))}
      </ol>
      <button class="row__step" type="button" data-step="1" aria-label="Next machine"><Arrow dir="right" /></button>
      <button class="row__coin" type="button" data-coin>Surprise me</button>
    </nav>
    <p class="hall__hint" aria-hidden="true">Drag or use the arrow keys to walk the row. Enter plays.</p>
    <p class="coach" data-coach hidden aria-hidden="true"><span class="coach__dot"></span>Swipe to walk the row</p>
    <p class="attract" data-attract-note hidden>Attract mode. Touch or press any key to take over.</p>
  </section>

  <section class="about" aria-labelledby="about-h">
    <h2 id="about-h">Twelve small games, one room</h2>
    <p>Snake, pinball, Minesweeper, sudoku, noughts and crosses, table tennis, air hockey, ten-pin bowling, a 3D endless runner, free throws, a hedge maze chase and a typing race. Every screen in the hall is playing a real recording of its game. Each machine takes tokens: you start with 12, good runs pay some back, and your cup refills while you are away. <a class="link" href="/tokens">How the arcade works</a></p>
    <p class="about__small">The hall is drawn live in WebGL 2: the machines, their art and the room are built in the browser when the page opens, and the floor reflects whatever the screens are showing. Day and Night follow your system until you pick one.</p>
  </section>
</Base>
<script src="../scripts/arcade.ts"></script>

<style>
  /* The hall fills the first screen. Until the canvas draws, a photograph of it stands in. */
  .hall {
    position: relative; height: 100svh; min-height: 320px; overflow: hidden; isolation: isolate;
    --sl: max(var(--edge), env(safe-area-inset-left)); --sr: max(var(--edge), env(safe-area-inset-right));
    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
    background: #0b0a0f center / cover no-repeat url("/hall/night.webp");
    color: #f4f1ea; transition: color 900ms var(--ease);
  }
  /* Flying into a screen: the page's own furniture steps aside. */
  .hall__top, .hall__cards, .hall__row, .hall__hint { transition: opacity 300ms var(--ease); }
  :global(html[data-entering]) :is(.hall__top, .hall__cards, .hall__row, .hall__hint) { opacity: 0; pointer-events: none; }
  :global(html[data-theme="day"]) .hall { background-color: #b9b3aa; background-image: url("/hall/day.webp"); color: #1f1d18; }
  .hall__gl { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0; transition: opacity 600ms var(--ease); touch-action: pan-y; cursor: grab; }
  :global(html[data-hall-live]) .hall__gl { opacity: 1; }
  .hall__top {
    position: absolute; inset: 0 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: calc(var(--edge) + env(safe-area-inset-top)) var(--sr) 0 calc(var(--sl) + 8px);
  }
  .hall__mark { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; font-size: clamp(1.375rem, 1rem + 1vw, 1.875rem); font-weight: 800; letter-spacing: -0.035em; }
  /* A 44 px target without moving the line. */
  .hall__mark a { font-size: var(--t-sm); font-weight: 600; letter-spacing: 0; padding: 16px 0; margin: -16px 0; }
  .hall__tools { display: flex; align-items: center; gap: 8px; }
  .hall__tools > .hall__card { display: contents; }
  .card, .hall__row ol, .hall__tools > :global(*), .row__step {
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 14%, transparent);
  }
  .hall__sound svg { width: 16px; height: 16px; }
  .hall__sound .off, .hall__sound[aria-pressed="false"] .on { display: none; }
  .hall__sound[aria-pressed="false"] .off { display: inline; }

  /* The card for the machine in focus. */
  .hall__cards { position: absolute; left: var(--sl); bottom: calc(96px + env(safe-area-inset-bottom)); width: min(440px, calc(100% - var(--sl) - var(--sr))); }
  .card { display: grid; gap: 12px; padding: 22px 24px 20px; border-radius: 16px; }
  .card[hidden] { display: none; }
  .card:not([hidden]) { animation: card 420ms var(--ease) both; }
  @keyframes card { from { opacity: 0; translate: -12px 0; } }
  .card__kind { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: var(--t-sm); font-weight: 600; }
  .card__kind > :not(.card__last) { opacity: 0.8; }
  .card__last { padding: 3px 9px; border-radius: 999px; background: var(--g-bright); color: #101010; font-size: 0.75rem; font-weight: 700; }
  .card__best { font-size: var(--t-sm); font-weight: 650; color: var(--g-bright); }
  .card__price { font-size: var(--t-sm); font-weight: 650; display: flex; align-items: center; gap: 8px; }
  .card__price::before { content: ""; width: 14px; height: 14px; border-radius: 50%; flex: none; background: radial-gradient(circle at 35% 30%, #fff2b8, #f6c53d 45%, #a86a06); box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25); }
  .card__play[aria-disabled="true"] { filter: grayscale(1); opacity: 0.7; }
  :global(html[data-theme="day"]) .card__best { color: color-mix(in srgb, var(--g-ground) 85%, black); }
  .card__name { font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.9; color: var(--g-bright); text-shadow: 0 0 28px color-mix(in srgb, var(--g-bright) 45%, transparent); }
  :global(html[data-theme="day"]) .card__name { color: var(--g-ground); text-shadow: none; }
  .card__line { font-size: var(--t-body); line-height: 1.4; }
  .card__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin-top: 6px; }
  .card__play {
    display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 24px; border-radius: 999px;
    background: var(--g-bright); color: var(--g-ground); font-weight: 750; font-size: var(--t-md); text-decoration: none;
    box-shadow: 0 0 0 0 var(--g-bright); transition: transform 220ms var(--spring), box-shadow 300ms;
  }
  .card__play :global(svg) { width: 14px; height: 14px; }
  .card__play:hover { transform: translateY(-2px); box-shadow: 0 8px 30px -6px var(--g-bright); }
  .card__play:active { transform: scale(0.96); }
  .card__about { display: inline-flex; align-items: center; gap: 0.25em; min-height: 44px; font-weight: 600; }

  /* The row: one button per machine, the steppers and the coin. */
  .hall__row { position: absolute; left: var(--sl); right: var(--sr); bottom: calc(var(--edge) + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 8px; }
  .hall__row ol { display: flex; gap: 2px; padding: 4px; border-radius: 999px; overflow-x: auto; scrollbar-width: none; min-width: 0; flex: 1; scroll-snap-type: x proximity; overscroll-behavior-x: contain; }
  /* Fade the strip's ends when it scrolls, so it reads as more than it shows. */
  @media (max-width: 1100px) { .hall__row ol { mask-image: linear-gradient(90deg, transparent, #000 18px, #000 calc(100% - 18px), transparent); } }
  .hall__row ol::-webkit-scrollbar { display: none; }
  .hall__row li { flex: 1 0 auto; scroll-snap-align: center; }
  .hall__row li button {
    width: 100%; min-height: 48px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; color: inherit;
    font: 600 var(--t-sm) / 1 var(--font); white-space: nowrap; cursor: pointer; transition: background-color 200ms, color 200ms;
  }
  .hall__row li button .num { opacity: 0.55; margin-right: 4px; }
  .hall__row li button:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .hall__row li button[aria-current="true"] { background: var(--g-bright); color: #101010; }
  .hall__row li button[aria-current="true"] .num { opacity: 0.7; }
  .hall__row li button.is-last:not([aria-current])::after { content: ""; display: inline-block; width: 6px; height: 6px; margin-left: 6px; border-radius: 50%; background: var(--g-bright); vertical-align: middle; }
  .row__step, .row__coin {
    flex: none; display: grid; place-items: center; min-width: 52px; min-height: 52px; border: 0; border-radius: 999px; cursor: pointer;
    color: inherit; transition: transform 200ms var(--spring);
  }
  .row__step :global(svg) { width: 16px; height: 16px; }
  .row__step:active, .row__coin:active { transform: scale(0.92); }
  .row__coin { padding: 0 20px; font: 700 var(--t-sm) / 1 var(--font); background: color-mix(in srgb, currentColor 12%, transparent); }
  .hall__hint { position: absolute; right: calc(var(--edge) + 8px); bottom: calc(84px + env(safe-area-inset-bottom)); font-size: var(--t-sm); opacity: 0.7; }
  :global(html:not([data-hall-live])) .hall__hint { display: none; }

  /* First visit on a touch screen: a finger sweeps across the hall until the first swipe. */
  .coach, .attract {
    position: absolute; left: var(--free-x, 50%); top: var(--free-y, 42%); translate: -50% -50%; display: flex; align-items: center; gap: 10px; padding: 12px 18px; border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    font: 650 var(--t-sm) / 1 var(--font); white-space: nowrap; pointer-events: none; transition: opacity 400ms var(--ease);
  }
  .coach[hidden], .attract[hidden] { display: none; }
  .coach.is-done { opacity: 0; }
  .coach__dot { width: 14px; height: 14px; border-radius: 50%; background: currentColor; animation: sweep 1.6s var(--ease) infinite; }
  @keyframes sweep { 0% { translate: 14px 0; opacity: 0; } 25% { opacity: 1; } 80% { translate: -14px 0; opacity: 1; } 100% { translate: -14px 0; opacity: 0; } }
  .attract { top: auto; bottom: calc(84px + env(safe-area-inset-bottom)); left: auto; right: var(--sr); translate: none; animation: blink 2.4s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0.55; } }
  :global(html[data-attract]) .hall__hint { display: none; }

  .about { padding: 120px var(--edge) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px var(--gap); }
  .about h2 { grid-column: 1 / span 5; font-size: var(--t-display); }
  .about p { grid-column: 7 / span 6; font-size: var(--t-lg); line-height: 1.2; letter-spacing: -0.015em; font-weight: 500; }
  .about .about__small { grid-column: 7 / span 5; font-size: var(--t-body); line-height: 1.5; letter-spacing: 0; font-weight: 400; color: var(--muted); }


  @media (max-width: 1100px) {
    .about h2, .about p, .about .about__small { grid-column: 1 / -1; }
    .hall__hint { display: none; }
  }
  /* Below 900 px the tools drop to icons: the hall needs the width more than the labels do. */
  @media (max-width: 900px) {
    .hall__tools :global(.still-toggle span), .hall__label { display: none !important; }
    .hall__tools :global(.still-toggle) { padding: 0 14px; min-width: 44px; justify-content: center; }
    .hall__tools :global(.lights label:not(:first-of-type) span) { display: none; }
  }
  @media (max-width: 720px) {
    .hall__top { flex-direction: column; align-items: flex-start; gap: 8px; }
    .hall__cards { bottom: calc(76px + env(safe-area-inset-bottom)); }
    .card { padding: 16px 18px 14px; gap: 8px; border-radius: 14px; }
    .card__name { font-size: clamp(2.25rem, 1.5rem + 4vw, 3rem); }
    .card__line { font-size: var(--t-sm); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
    .card__acts { flex-wrap: nowrap; gap: 16px; margin-top: 2px; }
    .card__play { min-height: 48px; font-size: var(--t-body); padding: 0 20px; white-space: nowrap; min-width: 0; }
    .card__about { white-space: nowrap; }
    .card__about-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .row__step { display: none; }
    .row__coin { padding: 0 16px; }
    .hall__row li button { min-height: 44px; }
  }
  /* A phone on its side: one bar along the top, the card down the left, the row along the foot. */
  @media (orientation: landscape) and (max-height: 520px) {
    .hall__top { flex-direction: row; align-items: center; padding-top: calc(8px + env(safe-area-inset-top)); }
    .hall__mark { font-size: 1.25rem; }
    .hall__mark a { display: none; }
    .hall__cards { top: 64px; bottom: calc(68px + env(safe-area-inset-bottom)); width: min(300px, 42vw); display: flex; align-items: flex-end; }
    .card { width: 100%; padding: 14px 16px; gap: 6px; }
    .card__name { font-size: 2rem; }
    .card__line { display: none; }
    .card__play { min-height: 44px; font-size: var(--t-sm); padding: 0 16px; }
    .hall__row { bottom: calc(8px + env(safe-area-inset-bottom)); }
    .row__step { display: none; }
    .hall__row li button, .row__coin { min-height: 44px; }
    .attract { bottom: calc(64px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 640px) {
    .about { padding-top: 88px; }
  }
</style>
