---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import StillToggle from "../components/StillToggle.astro";
import Lights from "../components/Lights.astro";
import { games, site } from "../data/games";

const posts = games.filter((g) => g.post);
const posters = await Promise.all(games.map((g) => getImage({ src: g.poster, width: 480, format: "webp", quality: 72 })));
const hall = games.map((g, i) => ({ slug: g.slug, name: g.name, kind: g.kind, ground: g.ground, bright: g.bright, poster: posters[i].src, clip: `/media/${g.slug}.mp4` }));
const pad = (n: number) => String(n).padStart(2, "0");

const title = "The Arcade: ten free browser games by Ashwin Sathian";
const description = "Ten small games in a 3D arcade that opens in a browser tab on phone, tablet or desktop. Free, with no install, no sign-up and no ads, and nine are one HTML file under 60 KB.";
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site.url}/#site`,
    url: site.url,
    name: site.name,
    description,
    inLanguage: "en-GB",
    author: { "@type": "Person", "@id": `${site.authorUrl}/#person`, name: site.author, url: site.authorUrl, sameAs: [site.github] },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Games",
    numberOfItems: games.length,
    itemListElement: games.map((g, i) => ({ "@type": "ListItem", position: i + 1, url: `${site.url}/${g.slug}`, name: g.name })),
  },
];
---
<Base {title} {description} og="index" ogAlt="The Arcade at night: a row of ten game cabinets under downlights, each screen playing its game, with a pink ARCADE neon on the wall." {jsonld}>
  <section class="hall" data-hall aria-labelledby="title">
    <canvas class="hall__gl" data-games={JSON.stringify(hall)} aria-hidden="true"></canvas>
    <header class="hall__top">
      <h1 id="title" class="hall__mark"><span>The Arcade</span> <a class="link" href={site.authorUrl}>by {site.author}</a></h1>
      <div class="hall__tools">
        <Lights />
        <button class="still-toggle hall__sound" type="button" aria-pressed="true" data-sound hidden><span>Sound</span></button>
        <StillToggle />
      </div>
    </header>

    <div class="hall__cards" aria-live="polite">
      {games.map((g, i) => (
        <article class="card" id={`m-${g.slug}`} data-card hidden={i !== 0} style={`--g-ground:${g.ground};--g-bright:${g.bright}`} aria-labelledby={`n-${g.slug}`}>
          <p class="card__kind"><span class="num">{pad(i + 1)} / {pad(games.length)}</span> {g.kind}</p>
          <h2 id={`n-${g.slug}`} class="card__name">{g.name}</h2>
          <p class="card__line">{g.line}</p>
          <p class="card__acts">
            <a class="card__play" href={g.url} data-play>Play {g.name} <Arrow /></a>
            <a class="card__about link" href={`/${g.slug}`}>About {g.name}</a>
          </p>
        </article>
      ))}
    </div>

    <nav class="hall__row" aria-label="Machines">
      <button class="row__step" type="button" data-step="-1" aria-label="Previous machine"><Arrow dir="left" /></button>
      <ol>
        {games.map((g, i) => (
          <li><button type="button" data-go={i} aria-current={i === 0 ? "true" : undefined} aria-controls={`m-${g.slug}`} style={`--g-bright:${g.bright}`}><span class="num">{pad(i + 1)}</span> {g.name}</button></li>
        ))}
      </ol>
      <button class="row__step" type="button" data-step="1" aria-label="Next machine"><Arrow dir="right" /></button>
      <button class="row__coin" type="button" data-coin>Insert coin</button>
    </nav>
    <p class="hall__hint" aria-hidden="true">Drag or use the arrow keys to walk the row. Enter plays.</p>
  </section>

  <section class="about" aria-labelledby="about-h">
    <h2 id="about-h">Ten small games, one room</h2>
    <p>Snake, pinball, Minesweeper, sudoku, noughts and crosses, table tennis, a 3D endless runner, free throws, a hedge maze chase and a typing race. Every screen in the hall is playing a real recording of its game. Each one opens in a tab on a phone or a laptop, with nothing to install and no account to make.</p>
    <p class="about__small">The hall is drawn live in WebGL 2: the machines, their art and the room are built in the browser when the page opens, and the floor reflects whatever the screens are showing. Day and Night follow your system until you pick one.</p>
  </section>

  <section class="made" aria-labelledby="made-h">
    <h2 id="made-h">The engineering underneath</h2>
    <p class="made__lede">Four of the games have a write-up on how they work.</p>
    <ul class="posts reveal">
      {posts.map((g) => (
        <li style={`--c:${g.bright};--d:${g.ground}`}>
          <a href={g.post!.url}>
            <span class="posts__game">{g.name}</span>
            <span class="posts__title">{g.post!.title}</span>
            <span class="posts__go">Read on ashwinsathian.com <Arrow /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
<script src="../scripts/arcade.ts"></script>

<style>
  /* The hall fills the first screen. Until the canvas draws, a photograph of it stands in. */
  .hall {
    position: relative; height: 100svh; min-height: 560px; overflow: hidden; isolation: isolate;
    background: #0b0a0f center / cover no-repeat url("/hall/night.webp");
    color: #f4f1ea; transition: color 900ms var(--ease);
  }
  /* Flying into a screen: the page's own furniture steps aside. */
  .hall__top, .hall__cards, .hall__row, .hall__hint { transition: opacity 300ms var(--ease); }
  :global(html[data-entering]) :is(.hall__top, .hall__cards, .hall__row, .hall__hint) { opacity: 0; pointer-events: none; }
  :global(html[data-theme="day"]) .hall { background-color: #b9b3aa; background-image: url("/hall/day.webp"); color: #1f1d18; }
  .hall__gl { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0; transition: opacity 600ms var(--ease); touch-action: pan-y; cursor: grab; }
  :global(html[data-hall-live]) .hall__gl { opacity: 1; }
  .hall__top {
    position: absolute; inset: 0 0 auto; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: calc(var(--edge) + env(safe-area-inset-top)) var(--edge) 0 calc(var(--edge) + 8px);
  }
  .hall__mark { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; font-size: clamp(1.375rem, 1rem + 1vw, 1.875rem); font-weight: 800; letter-spacing: -0.035em; }
  .hall__mark a { font-size: var(--t-sm); font-weight: 600; letter-spacing: 0; }
  .hall__tools { display: flex; align-items: center; gap: 8px; }
  .card, .hall__row ol, .hall__tools > :global(*), .row__step {
    background: color-mix(in srgb, var(--bg) 74%, transparent);
    backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 14%, transparent);
  }
  .hall__sound[aria-pressed="false"] span { text-decoration: line-through; }

  /* The card for the machine in focus. */
  .hall__cards { position: absolute; left: var(--edge); bottom: calc(96px + env(safe-area-inset-bottom)); width: min(440px, calc(100% - 2 * var(--edge))); }
  .card { display: grid; gap: 12px; padding: 22px 24px 20px; border-radius: 16px; }
  .card[hidden] { display: none; }
  .card:not([hidden]) { animation: card 420ms var(--ease) both; }
  @keyframes card { from { opacity: 0; translate: -12px 0; } }
  .card__kind { display: flex; gap: 10px; font-size: var(--t-sm); font-weight: 600; opacity: 0.8; }
  .card__name { font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.9; color: var(--g-bright); text-shadow: 0 0 28px color-mix(in srgb, var(--g-bright) 45%, transparent); }
  :global(html[data-theme="day"]) .card__name { color: var(--g-ground); text-shadow: none; }
  .card__line { font-size: var(--t-body); line-height: 1.4; }
  .card__acts { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin-top: 6px; }
  .card__play {
    display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 24px; border-radius: 999px;
    background: var(--g-bright); color: var(--g-ground); font-weight: 750; font-size: var(--t-md); text-decoration: none;
    box-shadow: 0 0 0 0 var(--g-bright); transition: transform 220ms var(--spring), box-shadow 300ms;
  }
  .card__play :global(svg) { width: 14px; height: 14px; }
  .card__play:hover { transform: translateY(-2px); box-shadow: 0 8px 30px -6px var(--g-bright); }
  .card__play:active { transform: scale(0.96); }
  .card__about { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }

  /* The row: one button per machine, the steppers and the coin. */
  .hall__row { position: absolute; left: var(--edge); right: var(--edge); bottom: calc(var(--edge) + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 8px; }
  .hall__row ol { display: flex; gap: 2px; padding: 4px; border-radius: 999px; overflow-x: auto; scrollbar-width: none; min-width: 0; flex: 1; scroll-snap-type: x proximity; }
  .hall__row ol::-webkit-scrollbar { display: none; }
  .hall__row li { flex: 1 0 auto; scroll-snap-align: center; }
  .hall__row li button {
    width: 100%; min-height: 48px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; color: inherit;
    font: 600 var(--t-sm) / 1 var(--font); white-space: nowrap; cursor: pointer; transition: background-color 200ms, color 200ms;
  }
  .hall__row li button .num { opacity: 0.55; margin-right: 4px; }
  .hall__row li button:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .hall__row li button[aria-current="true"] { background: var(--g-bright); color: #101010; }
  .hall__row li button[aria-current="true"] .num { opacity: 0.7; }
  .row__step, .row__coin {
    flex: none; display: grid; place-items: center; min-width: 52px; min-height: 52px; border: 0; border-radius: 999px; cursor: pointer;
    color: inherit; transition: transform 200ms var(--spring);
  }
  .row__step :global(svg) { width: 16px; height: 16px; }
  .row__step:active, .row__coin:active { transform: scale(0.92); }
  .row__coin { padding: 0 20px; font: 700 var(--t-sm) / 1 var(--font); background: #ffcf3d; color: #241a00; box-shadow: 0 0 24px -4px #ffcf3d; }
  .hall__hint { position: absolute; right: calc(var(--edge) + 8px); bottom: calc(84px + env(safe-area-inset-bottom)); font-size: var(--t-sm); opacity: 0.7; }
  :global(html:not([data-hall-live])) .hall__hint { display: none; }

  .about { padding: 120px var(--edge) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px var(--gap); }
  .about h2 { grid-column: 1 / span 5; font-size: var(--t-display); }
  .about p { grid-column: 7 / span 6; font-size: var(--t-lg); line-height: 1.2; letter-spacing: -0.015em; font-weight: 500; }
  .about .about__small { grid-column: 7 / span 5; font-size: var(--t-body); line-height: 1.5; letter-spacing: 0; font-weight: 400; color: var(--muted); }

  .made { padding: 140px var(--edge) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); }
  .made h2 { grid-column: 1 / span 6; font-size: var(--t-display); }
  .made__lede { grid-column: 7 / span 5; align-self: end; font-size: var(--t-md); line-height: 1.4; }
  .posts { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); margin-top: 40px; }
  .posts a {
    display: flex; flex-direction: column; gap: 16px; min-height: 340px; padding: 24px;
    border-radius: var(--r); background: var(--d); color: #f1efe8; text-decoration: none;
    transition: transform 260ms var(--spring);
  }
  .posts a:hover { transform: translateY(-6px); }
  .posts__game { color: var(--c); font-weight: 700; font-size: var(--t-md); }
  .posts__title { font-size: var(--t-lg); line-height: 1.08; letter-spacing: -0.02em; font-weight: 600; margin-bottom: auto; }
  .posts__go { display: flex; align-items: center; gap: 8px; font-size: var(--t-sm); }
  .posts__go :global(svg) { width: 12px; }

  @media (max-width: 1100px) {
    .about h2, .about p, .about .about__small { grid-column: 1 / -1; }
    .posts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .made h2, .made__lede { grid-column: 1 / -1; }
    .hall__hint { display: none; }
  }
  @media (max-width: 720px) {
    .hall__top { flex-direction: column; align-items: flex-start; gap: 10px; }
    .hall__tools :global(.still-toggle span) { display: none; }
    .hall__tools :global(.still-toggle) { padding: 0 14px; }
    .hall__sound span { display: inline !important; }
    .hall__cards { bottom: calc(80px + env(safe-area-inset-bottom)); }
    .card { padding: 18px 18px 16px; gap: 8px; }
    .card__line { font-size: var(--t-sm); }
    .card__play { min-height: 48px; font-size: var(--t-body); }
    .row__step { display: none; }
    .row__coin { padding: 0 16px; }
  }
  @media (max-width: 640px) {
    .posts { grid-template-columns: 1fr; }
    .posts a { min-height: 220px; }
    .about, .made { padding-top: 88px; }
  }
</style>
