---
// 1200x630 social cards, laid out as HTML and photographed by scripts/og.ts into public/og/<card>.jpg.
// These pages are noindex and left out of the sitemap.
import "../../styles/global.css";
import { getImage } from "astro:assets";
import { games, type Game } from "../../data/games";

export function getStaticPaths() {
  return [{ params: { card: "index" } }, ...games.map((g) => ({ params: { card: g.slug } }))];
}
const { card } = Astro.params;
const game: Game | undefined = games.find((g) => g.slug === card);
const posters = await Promise.all(games.map((g) => getImage({ src: g.poster, width: 400, format: "webp" })));
const one = game && (await getImage({ src: game.poster, width: 720, format: "webp" }));
---
<!doctype html>
<html lang="en-GB">
<head><meta charset="utf-8" /><meta name="robots" content="noindex" /><title>card</title></head>
<body>
  {game ? (
    <div class="card one" style={`--g:${game.ground};--b:${game.bright}`}>
      <div class="txt">
        <p class="kind">{game.kind} · free in your browser</p>
        <h1>{game.name}</h1>
        <p class="line">{game.line}</p>
        <p class="site">games.ashwinsathian.com</p>
      </div>
      <img src={one!.src} alt="" />
    </div>
  ) : (
    <div class="card all">
      <div class="txt"><h1>Ten small games for your browser</h1><p class="site">games.ashwinsathian.com</p></div>
      {games.map((g, i) => <figure style={`--g:${g.ground};--b:${g.bright}`}><img src={posters[i].src} alt="" /><figcaption>{g.name}</figcaption></figure>)}
    </div>
  )}
</body>
</html>
<style>
  body { margin: 0; width: 1200px; height: 630px; overflow: hidden; background: #dfdedb; color: #26251e; }
  .card { width: 1200px; height: 630px; padding: 12px; display: grid; gap: 8px; }
  .txt { border-radius: 8px; padding: 36px; display: flex; flex-direction: column; gap: 18px; }
  h1 { margin: 0; }
  .site { margin-top: auto; font-size: 22px; font-weight: 600; }
  .one { grid-template-columns: 1fr 420px; }
  .one .txt { background: var(--g); color: #f1efe8; }
  .one .kind { color: var(--b); font-size: 28px; font-weight: 600; }
  .one h1 { font-size: 150px; color: var(--b); font-weight: 800; letter-spacing: -0.05em; }
  .one .line { font-size: 34px; line-height: 1.15; }
  .one img { width: 420px; height: 606px; object-fit: cover; border-radius: 8px; }
  .all { grid-template-columns: 1.6fr repeat(5, 1fr); grid-template-rows: 1fr 1fr; }
  /* Ten games in ten slots, five to a row. */
  .all .txt { grid-row: span 2; background: #26251e; color: #dfdedb; }
  .all h1 { font-size: 58px; line-height: 0.95; letter-spacing: -0.04em; }
  figure { margin: 0; position: relative; border-radius: 8px; overflow: hidden; background: var(--g); }
  figure img { width: 100%; height: 100%; object-fit: cover; }
  figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 10px 14px; background: var(--g); color: var(--b); font-weight: 700; font-size: 24px; }
</style>
