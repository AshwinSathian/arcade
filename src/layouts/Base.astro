---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { site } from "../data/games";

interface Props {
  title: string;
  description: string;
  /** Path of the social card under /og, without extension. */
  og: string;
  /** What the social card shows, for people who cannot see it. */
  ogAlt: string;
  jsonld: object[];
  noindex?: boolean;
}
const { title, description, og, ogAlt, jsonld, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, "").replace(/(.)\/$/, "$1") || "/", site.url).href;
const image = `${site.url}/og/${og}.jpg`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large, max-video-preview:-1"} />
    <meta name="author" content={site.author} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#dfdedb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Plain-text summary for language models" />
    <link rel="me" href={site.authorUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <main id="main"><slot /></main>
    <Footer />
    <div class="navsk" aria-hidden="true"><i class="a sk"></i><i class="b sk"></i><i class="c sk"></i><i class="d sk"></i></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
