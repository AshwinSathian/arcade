{
  "prerender": [
    {
      "where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": ["/*.txt", "/*.xml", "/*.png", "/*.jpg", "/*.mp4", "/og/*", "/cards/*"] } }] },
      "eagerness": "moderate"
    }
  ],
  "prefetch": [
    {
      "where": { "selector_matches": "a[data-play]" },
      "eagerness": "moderate"
    }
  ]
}
